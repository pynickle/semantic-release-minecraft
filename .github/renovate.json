{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchPackageNames": ["@types/node"],
      "allowedVersions": "24.x"
    },
    {
      "enabled": false,
      "matchDepTypes": [
        "peerDependencies"
      ]
    },
    {
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["pnpm/action-setup"],
      "enabled": false
    }
  ]
}
